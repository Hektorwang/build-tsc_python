# 由 build.sh 渲染生成, 请勿手工编辑
# 模板占位符: @VERSION@ @RELEASE@ @ARCH@ @STAGE_DIR@
name: tsc_python
arch: "@ARCH@"
platform: linux
version: "@VERSION@"
release: "@RELEASE@"
maintainer: tsc_python maintainers
vendor: TSC
description: |
  TSC Python 运行时发行版: micromamba 管理的 Python 环境 (ansible 等) 及其插件模块。
  按 CPU 架构分别出包, 环境在 CentOS 7.9 (glibc 2.17 基线) 容器中构建,
  兼容所有 glibc >= 2.17 的 Linux 发行版。

# 硬依赖:
#   bash >= 4.0   scriptlet 使用关联数组, 低于 4.0 的 bash 由 %pre 显式拦下
#   glibc >= 2.17 环境构建基线, 目标机低于该值时环境无法运行 (%pre 亦会校验)
#   grep / sed    scriptlet (如 tsc_tools 的 gen_rag) 处理文本时使用
#   findutils     %postun 用 find 自底向上清理本包空目录壳
#   tsc_tools >= 2.1.8
#                profile 以 drop-in 形式提供 (/home/tsc/tsc_profile.d/01-tsc_python-profile.sh),
#                需 tsc_tools 的 tsc_profile 才会加载该目录下的 *.sh;
#                %post 不改写已存在的 tsc_profile (仅缺失时用包内模板创建), 不碰 tsc_tools 的文件。
#                下限取 2.1.8 而非 2.1.6: rag.md 膨胀的根因 (TSC_MODULES_DIR 被重复追加)
#                修在 tsc_tools 侧 (其 drop-in 判重 + gen_rag.sh 去重), 本包 %post 调用的
#                正是 tsc_tools 随包的 gen_rag.sh, 低版本仍会产出成倍重复的 rag.md
depends:
  - bash >= 4.0
  - coreutils
  - findutils
  - glibc >= 2.17
  - grep
  - sed
  - tsc_tools >= 2.1.8

contents:
  # 包内容统一挂在 /home/tsc 下: tsc_python/(环境本体 + profile 源 + ansible 配置 + 插件模块)
  # drop-in 与 tsc_profile 公共入口由 %post 从 tsc_python/ 下部署到 /home/tsc, 不进文件清单
  # ansible 的 base.yml 以普通文件随本目录树入包 (0.13.5 起放弃 %config(noreplace) 单独
  # 声明, 理由见 README-dev §4.8); %post 的 patch_ansible.py 在安装/升级后幂等重打补丁
  - src: "@STAGE_DIR@/payload/home/tsc/"
    dst: /home/tsc

  # ansible/hosts 拆出目录树单独入包 (0.13.8, build.sh 把 stage 树中的该文件移出为
  # @STAGE_DIR@/ansible-hosts 并 chmod 0600): 该文件是模块工作流的现场编辑点 (受管主机
  # 与 SSH 凭据), 以普通文件随目录树入包时 rpm -U 会用包内模板静默覆盖现场 inventory;
  # noreplace 语义下升级保留现场版本 (新版模板落成 hosts.rpmnew), 真卸载时现场改过的
  # 版本转存 hosts.rpmsave 而非删除。base.yml 放弃 %config 的 schema 漂移理由不适用于
  # hosts——它是纯数据模板, 不存在缺新配置定义的问题 (README-dev §4.11)
  - src: "@STAGE_DIR@/ansible-hosts"
    dst: /home/tsc/tsc_python/ansible/hosts
    type: config|noreplace

scripts:
  preinstall: "@STAGE_DIR@/rpm-scripts/preinstall"
  postinstall: "@STAGE_DIR@/rpm-scripts/postinstall"
  preremove: "@STAGE_DIR@/rpm-scripts/preremove"
  postremove: "@STAGE_DIR@/rpm-scripts/postremove"

rpm:
  arch: "@ARCH@"
  # gzip 兼容性最广 (EL7 的 rpm 不支持 zstd), 代价是体积略大
  compression: gzip
