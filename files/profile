# tsc_python drop-in
# 由 tsc_python RPM 部署到 /home/tsc/tsc_profile.d/01-tsc_python-profile.sh
# 卸载本包时由 %preun 删除; tsc_profile 主入口与 tsc_profile.d 目录保留

# 本包 Python 环境 (mamba root + envs/tsc_python)
export MAMBA_ROOT_PREFIX=/home/tsc/tsc_python
eval "$("${MAMBA_ROOT_PREFIX}"/bin/micromamba shell hook --shell bash)"
micromamba activate tsc_python
export ANSIBLE_CONFIG=/home/tsc/tsc_python/ansible/ansible.cfg

# 模块目录: 本包模块独占 /home/tsc/tsc_python/modules (与 tsc_tools 的 modules 解耦)。
# tsc (tsc_tools >= 2.1.7) 按 ${TSC_MODULES_DIR} (冒号分隔多目录) 遍历模块并据此生成 rag,
# 所以本包也要声明一次——否则单独安装 tsc_python 时模块发现不了。
# 00-tsc_tools-profile.sh (tsc_tools 的 drop-in, 数字前缀小于本包故先加载) 已声明过
# 则跳过: 同一目录重复出现在变量里会让 gen_rag.sh 把同一份 readme 收录两次。
# 判重是必须的: 本文件会被 source 多次 (嵌套 shell / 脚本重复 source tsc_profile),
# 无条件追加会让 TSC_MODULES_DIR 里出现重复目录, rag.md 成倍膨胀。
if [[ ":${TSC_MODULES_DIR:-}:" != *":/home/tsc/tsc_python/modules:"* ]]; then
  export TSC_MODULES_DIR="/home/tsc/tsc_python/modules${TSC_MODULES_DIR:+:${TSC_MODULES_DIR}}"
fi
